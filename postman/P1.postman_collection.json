      "name": "1. 健康检查",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "response": []
    },
    {
      "name": "1.1 数据库建表检查（应全部 OK）",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health/db",
          "host": ["{{baseUrl}}"],
          "path": ["health", "db"]
        }
      },
      "response": []
    },
    {
